pipeline {
    agent any

    environment {
        DOCKER_USER = 'aniiket2025'
        DOCKER_REPO = 'flight-reservation-app'
        CLUSTER_NAME = 'VanRaj-cluster'
        REGION = 'ap-south-1'
        SONAR_HOST_URL = 'http://3.108.56.127:9000'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/aniket01299/flight-reservation-project.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv(installationName: 'sonarqube', credentialsId: 'Sonar') {
                    sh 'mvn sonar:sonar -Dsonar.projectKey=flight-reservation-app'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub_creds', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh '''
                        docker build -t ${DOCKER_USER}/${DOCKER_REPO}:${BUILD_NUMBER} .
                        docker login -u ${DOCKER_USERNAME} -p ${DOCKER_PASSWORD}
                        docker push ${DOCKER_USER}/${DOCKER_REPO}:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Update K8s Manifest') {
            steps {
                sh '''
                    sed -i "s|${DOCKER_USER}/${DOCKER_REPO}:latest|${DOCKER_USER}/${DOCKER_REPO}:${BUILD_NUMBER}|g" k8s/deployment.yaml
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'AWS-Cred', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    sh '''
                        aws eks update-kubeconfig --name ${CLUSTER_NAME} --region ${REGION}
                        kubectl apply -f k8s/deployment.yaml
                        kubectl apply -f k8s/service.yaml
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}


